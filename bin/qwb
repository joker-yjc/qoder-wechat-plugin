#!/bin/bash
# qwb：转发到 qoder-wechat-bridge 的命令启动器
# 解析顺序：插件自带依赖 -> 全局安装 -> npm 线上包
set -euo pipefail

ROOT="${QODER_PLUGIN_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"

# 1) 插件依赖（npm install 后存在）
if [ -x "$ROOT/node_modules/.bin/qoder-wechat" ]; then
  exec "$ROOT/node_modules/.bin/qoder-wechat" "$@"
fi

# 2) 全局安装的桥接包
if command -v qoder-wechat >/dev/null 2>&1; then
  exec qoder-wechat "$@"
fi

# 3) 线上包
exec npx -y @jcyao/qoder-wechat-bridge "$@"
